# Repository search safety defaults.
#
# These paths contain archival or generated evidence that can be enormous.
# Use compact status/proof scripts or exact files instead of broad ripgrep.
plans/archive/**
.codex/sdk/logs/**
.codex-autonomy/**
.codex-runtime/**
logs/**
node_modules/**
# Frozen legacy tooling; explicit paths remain readable for integrity checks.
orchestrator/**
!orchestrator/bounded-process-result.cjs
scripts/full-intake-runtime-cleanup.js
scripts/sdk-generic-repo-full-intake-smoke.js
scripts/sdk-generic-repo-importer-command-smoke.js
scripts/sdk-generic-repo-queue-supervisor-smoke.js
