{
  "mcpServers": {
    "after-effects": {
      "command": "node",
      "args": [
        "<AE_AGENT_REPO>\\mcp-server\\mcp-adapter.js"
      ],
      "env": {
        "AE_BRIDGE_PORT": "3456",
        "AE_BRIDGE_TOKEN": "<unique automation token>",
        "AE_BRIDGE_PANEL_TOKEN": "<different unique panel token>"
      }
    }
  }
}
