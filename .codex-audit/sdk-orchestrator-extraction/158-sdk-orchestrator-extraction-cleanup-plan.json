    },
    {
      "phase": 2,
      "name": "Extract reusable core without behavior change",
      "actions": [
        "Create a standalone tool workspace or repository from the core modules.",
        "Move generic policy-neutral logic first: envelope, path policy, git snapshots, runtime store, post-run contract, diagnostics, thread options.",
        "Keep AE Agent wrappers pointing at the existing local implementation until parity tests pass."
      ],
      "exitCriteria": [
        "standalone core tests pass locally",
        "AE Agent check:rules still passes without changing current governance artifacts"
      ]
    },
    {
      "phase": 3,
      "name": "Introduce AE Agent adapter config",
      "actions": [
        "Represent docs-audit, orchestrator, production-code, and cep-panel lanes as project adapter config.",
        "Keep cep-panel sdk-write disabled in the adapter.",
        "Generate or validate current M152/M154-M157 evidence against the adapter."
      ],
      "exitCriteria": [
        "current governance report remains local-gated with no drift",
        "production-code allowlist remains exactly scripts/provider-api-smoke.js and scripts/provider-contract-smoke.js",
        "CEP-panel remains disabled"
      ]
    },
    {
      "phase": 4,
      "name": "Summarize historical SDK evidence",
      "actions": [
        "Create a committed sdk-history index that records historical artifacts, verdicts, supersession chain, and commit ids.",
        "Update smokes to validate the index plus current evidence instead of every superseded packet.",
        "Only then consider moving historical files into a clearly named archive directory."
      ],
      "exitCriteria": [
        "history index is machine-checked",
        "current evidence remains directly checked",
        "git diff shows moves only after review"
      ]
    },
    {
      "phase": 5,
      "name": "Optional archive or squash follow-up",
      "actions": [
        "Archive candidates by move, not deletion, in a dedicated cleanup commit.",
        "Keep a short README or index linking to the original evidence.",
        "Do not archive current M152 governance, M153 next-lane, M154-M157 conveyor, provider smoke targets, or cep-panel/panel.js."
      ],
      "exitCriteria": [
        "node --check for touched JS files passes",
        "check:rules passes",
        "full configured local smoke suite passes or records a precise blocked reason"
      ]
    }
