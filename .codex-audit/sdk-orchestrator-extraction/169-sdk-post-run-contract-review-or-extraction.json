      "evaluatePreRunGitState",
      "assertPreRunGitState",
      "assertValidationResult",
      "validatePostRunContract",
      "validateSdkWriteDiffAllowlist",
      "validateSdkWritePlannedPathPrecondition"
    ],
    "adapterInjectedContract": {
      "scopePolicySource": "AE_AGENT_SDK_ADAPTER_CONFIG.scopes and AE_AGENT_SDK_ADAPTER_CONFIG.scopePathAllowlists via the runner facade",
      "forbiddenPathPolicySource": "AE_AGENT_SDK_ADAPTER_CONFIG.forbiddenPathPatterns via the runner facade",
      "sdkWritePlannedPathAllowlistSource": "AE_AGENT_SDK_ADAPTER_CONFIG.sdkWrite.plannedPathAllowlists via createSdkWritePlannedPathCheck",
      "productionCodeExistingSourceRequirementSource": "AE_AGENT_SDK_ADAPTER_CONFIG.sdkWrite.productionCodeScope injected as productionCodeScope"
    },
    "preservedBehavior": [
      "dirty pre-run state remains fail-closed unless every dirty path is acknowledged and no acknowledgement is stale",
      "forbidden dirty paths remain rejected even when acknowledged",
      "post-run write-capable diffs remain scoped by the active scope allowlist and forbidden path policy",
      "sdk-write planned paths are validated before comparing post-run diffs",
      "newly-created directory parents are normalized only after child enumeration proves every actual changed child is explicitly planned",
      "production-code sdk-write planned paths must already exist before SDK thread creation",
      "docs-audit and orchestrator sdk-write planned outputs remain new-output-only"
    ],
    "deferredCandidates": [
      "buffered-acceptance project-local split review"
    ]
